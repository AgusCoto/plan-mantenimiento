# Datos del proyecto de Supabase (Project Settings → API).
# Copiá este archivo como .env y completalo. No subas el .env al repositorio.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clave pública "anon" / "publishable": es pública por diseño, los permisos los controla la base.
VITE_SUPABASE_ANON_KEY=
# Dirección donde queda publicada la app (para los códigos QR). Si queda vacía se usa la dirección actual.
VITE_PUBLIC_URL=https://aguscoto.github.io/plan-mantenimiento/
