# Datos del proyecto de Supabase (Project Settings → API). Copiá este archivo como .env y completalo.
# No subas el .env al repositorio.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clave pública "anon" / "publishable": es pública por diseño, los permisos los controla la base.
VITE_SUPABASE_ANON_KEY=
# Clave PÚBLICA de las notificaciones push (VAPID). La privada va solo en los secretos de la función
# «avisos» de Supabase, nunca acá. Se generan con: npx web-push generate-vapid-keys (ver README → Avisos).
VITE_VAPID_PUBLIC_KEY=
