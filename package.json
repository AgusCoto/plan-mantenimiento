{
  "name": "app-mantenimiento",
  "version": "2.0.0",
  "private": true,
  "description": "App de mantenimiento del grupo (INY, LIM, PIN, SAL): equipos, órdenes de trabajo, reportes de falla y apariencia editable. React + Supabase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sql": "node scripts/armar-instalador.mjs",
    "test:permisos": "node supabase/tests/permisos.test.mjs",
    "test:avisos": "node --experimental-strip-types supabase/tests/funcion-avisos.test.mjs",
    "test:ejemplo": "node supabase/tests/datos-ejemplo.test.mjs",
    "test:e2e": "node tests/recorrido.e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "fflate": "^0.8.2",
    "idb": "8.0.0",
    "jspdf": "2.5.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "web-push": "^3.6.7"
  }
}
