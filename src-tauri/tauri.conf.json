{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plan de Mantenimiento",
  "version": "1.0.5",
  "identifier": "ar.mantenimiento.plan",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plan de Mantenimiento",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Plan de mantenimiento con seguimiento",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Spanish"], "installMode": "currentUser" }
    }
  }
}
